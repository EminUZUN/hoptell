{
  "description": "hoptell hook delivery: wake an idle session with a fixed notice when peer messages are waiting, and when messages are held for the user's decision; with HOPTELL_TITLE_AUTO=on, keep the session's custom title for list_peers",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoptell.js", "hook-session-start"], "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoptell.js", "hook-user-prompt-submit"], "timeout": 5 }] }
    ],
    "FileChanged": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoptell.js", "hook-file-changed"], "asyncRewake": true, "timeout": 10 }] }
    ]
  }
}
