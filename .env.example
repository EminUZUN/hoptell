# hoptell settings. Copy to .env (never commit it) on every machine.
# Real environment variables override this file.

# Where the relay runs (ws://, or wss:// behind a TLS proxy).
HOPTELL_RELAY=ws://192.0.2.10:7777

# Your member token (from `hoptell members add` on the relay), or the relay's shared secret:
# identical on the relay and every peer. Generate a shared secret with:
#   openssl rand -hex 32
HOPTELL_TOKEN=replace-me

# Or sign in with your identity provider instead of a token (run `hoptell login` first).
# The credential is kept in the OS keychain; HOPTELL_CREDENTIAL_STORE=file keeps it in a
# file encrypted with HOPTELL_CREDENTIAL_PASSPHRASE instead.
# HOPTELL_AUTH=login

# Optional fixed peer name for this machine's agent (letters, digits, _ and -).
# Leave unset when several sessions share a machine: the relay assigns each one a name.
# A second session with the same name waits until the first one ends.
# HOPTELL_NAME=laptop-claude

# Optional roles for fan-out messages (@reviewer, @backend, ...).
# HOPTELL_ROLES=reviewer,backend

# Optional title shown next to this session's name in other sessions' list_peers. It is a label
# only: messages still go to the name. At most 80 characters; "off" never sends a title.
# HOPTELL_TITLE=review docs

# Optional: how many spawned agent runs may be live at once in this home (default 4, at most 16).
# HOPTELL_AGENTS_MAX=4

# Experimental encrypted messages (not independently reviewed; see the README). The relay needs
# --experimental-e2ee. HOPTELL_MLS_WASM names the OpenMLS binding by absolute path, such as the
# one shipped in the package; replace <npm-root> with what `npm root -g` prints. Without an OS
# keychain, keep the device keys in an encrypted file with HOPTELL_CREDENTIAL_STORE=file and
# HOPTELL_CREDENTIAL_PASSPHRASE.
# HOPTELL_EXPERIMENTAL_E2EE=1
# HOPTELL_MLS_WASM=<npm-root>/hoptell/lib/mls/binding

# Relay only: interface and port to listen on.
# HOPTELL_HOST=192.0.2.10
# HOPTELL_PORT=7777
# Relay only: per-member tokens (see examples/members.example.json); chmod 600.
# HOPTELL_MEMBERS=/etc/hoptell/members.json
# Relay only: sign-in with identity providers (see examples/oidc.example.json); chmod 600.
# HOPTELL_OIDC=/etc/hoptell/oidc.json
# Relay only: keep a realm id when moving a relay to a new state directory (32 hex characters).
# HOPTELL_REALM_ID=
# Relay only: let owner-channel bridges serve their Telegram app through this relay (HTTPS only).
# HOPTELL_OWNER_APP=on
# Owner-channel bridge only: the public HTTPS address where Telegram opens the bridge's app.
# HOPTELL_APP_URL=https://hoptell.example.com
