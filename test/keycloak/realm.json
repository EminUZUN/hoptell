{
  "realm": "hoptell-test",
  "enabled": true,
  "accessTokenLifespan": 60,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "offline_access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "hoptell",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "hoptell-relay audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hoptell-relay",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "hoptell-cli",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "hoptell"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "hoptell-relay",
      "publicClient": false,
      "secret": "relay-introspection-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": []
    },
    {
      "clientId": "build-bot",
      "publicClient": false,
      "secret": "build-bot-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "hoptell"
      ]
    },
    {
      "clientId": "hoptell-broker",
      "publicClient": false,
      "secret": "broker-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Tester",
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ]
}
