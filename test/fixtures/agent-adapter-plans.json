{
 "codex/headless/read-only": {
  "command": "/bin/codex",
  "mode": "plain",
  "args": [
   "exec",
   "--ignore-user-config",
   "--ignore-rules",
   "--ephemeral",
   "--json",
   "-s",
   "read-only",
   "-c",
   "approval_policy=\"never\"",
   "-c",
   "features.apps=false",
   "-c",
   "features.plugins=false",
   "-c",
   "features.hooks=false",
   "-c",
   "features.browser_use=false",
   "-c",
   "features.browser_use_external=false",
   "-c",
   "features.browser_use_full_cdp_access=false",
   "-c",
   "features.computer_use=false",
   "-c",
   "features.multi_agent=false",
   "-c",
   "features.image_generation=false",
   "-c",
   "features.goals=false",
   "-c",
   "features.incremental_tools=false",
   "-c",
   "web_search=\"disabled\"",
   "-c",
   "agents.max_threads=1",
   "-C",
   "/work/sub",
   "-o",
   "/h/agents/runs/r-0123456789abcdef/result",
   "-c",
   "mcp_servers.hoptell.command=\"/node\"",
   "-c",
   "mcp_servers.hoptell.args=[\"/hoptell/bin/hoptell.js\", \"mcp\", \"--run\", \"r-0123456789abcdef\", \"--home\", \"/h\"]",
   "-c",
   "mcp_servers.hoptell.env={HOPTELL_RUN=\"r-0123456789abcdef\", HOPTELL_HOME=\"/h\", HOPTELL_ENV=\"/h/agents/runs/r-0123456789abcdef/env\", HOPTELL_RELAYS=\"/h/agents/runs/r-0123456789abcdef/relays.json\"}",
   "-c",
   "mcp_servers.hoptell.default_tools_approval_mode=\"approve\"",
   "-"
  ],
  "stdin": "task",
  "result": {
   "from": "file"
  }
 },
